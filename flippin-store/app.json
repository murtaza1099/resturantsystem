{
  "expo": {
    "name": "Flippin Store",
    "slug": "flippin-store",
    "owner": "flippin",
    "description": "Flippin Store — receive and manage orders for your restaurant or shop.",
    "version": "1.0.86",
    "orientation": "portrait",
    "icon": "./lib/assets/images/icon.png",
    "assetBundlePatterns": ["**/*"],
    "scheme": "flippin-store",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f8f5",
          "image": "./lib/assets/images/splashTransparent.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0b1225",
            "image": "./lib/assets/images/splashTransparent.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos for license, vehicle plate and profile image. Please allow these to continue using the app."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-video"
    ],
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.flippin.store",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "$(PRODUCT_NAME) uses your location for features like finding orders nearby and tracking customer orders!",
        "UIBackgroundModes": ["audio", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "NSBluetoothAlwaysUsageDescription": "We use Bluetooth to connect to your thermal printer.",
        "NSBluetoothPeripheralUsageDescription": "We use Bluetooth to connect to your thermal printer."
      }
    },
    "android": {
      "versionCode": 86,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "pk.flippin.store",
      "adaptiveIcon": {
        "foregroundImage": "./lib/assets/images/appIcon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
